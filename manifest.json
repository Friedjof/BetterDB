{
  "manifest_version": 3,
  "name": "DB Verbindungen Viewer",
  "version": "1.3.0",
  "description": "Demo: Extracts DB train connections with intermediate stops from sessionStorage - Educational/Research purpose only.",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["*://*.bahn.de/*"],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["pagehook.js"],
      "matches": ["*://*.bahn.de/*"]
    },
    {
      "resources": [
        "data-manager.js",
        "extractors/base-extractor.js",
        "extractors/vuex-extractor.js",
        "extractors/digital-data-extractor.js",
        "extractors/dom-extractor.js",
        "extractors/network-extractor.js",
        "utils/helpers.js",
        "utils/dom-utils.js",
        "utils/data-merger.js",
        "utils/context-manager.js",
        "utils/url-parser.js",
        "utils/route-graph.js",
        "utils/ticket-splitter.js"
      ],
      "matches": ["*://*.bahn.de/*"]
    }
  ],
  "action": {
    "default_title": "DB Verbindungen",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.bahn.de/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
